{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "v2rayV",
  "version": "1.0.1",
  "identifier": "com.v2rayv.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "v2rayV",
        "width": 420,
        "height": 680,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/xray",
      "binaries/hev-socks5-tunnel"
    ]
  }
}
